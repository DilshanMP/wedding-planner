# Everything is optional. With nothing set, the app runs in local mode:
# the plan and documents stay in this browser.

# Cloud mode (sign-in, sync across devices, family sharing, online RSVP,
# cloud document vault). Apply supabase/migrations to the project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Enables "Explain in more detail" answers from Claude in the
# assistant. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Server-only. Canva Connect ("Send to Canva" in EverAfter Studio). Create an
# integration at https://www.canva.com/developers/integrations/connect-api with
# the scopes asset:read, asset:write, design:content:write, design:meta:read
# and profile:read, and add the redirect URL
#   https://<your-domain>/api/canva/callback
# (for local testing: http://127.0.0.1:3000/api/canva/callback). Without these
# the Canva page explains that the connection is pending and offers downloads.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Any random string of 32+ characters; encrypts the tokens kept in the
# http-only cookie. Generate one with: openssl rand -base64 48
CANVA_TOKEN_KEY=
# Optional. Only if the redirect URL differs from <site>/api/canva/callback.
CANVA_REDIRECT_URI=
